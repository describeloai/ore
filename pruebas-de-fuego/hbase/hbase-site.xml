<?xml version="1.0"?>
<configuration>
  <property><name>hbase.cluster.distributed</name><value>false</value></property>
  <property><name>hbase.rootdir</name><value>file:///data/hbase</value></property>
  <property><name>hbase.zookeeper.property.dataDir</name><value>/data/zk</value></property>
  <property><name>hbase.unsafe.stream.capability.enforce</name><value>false</value></property>
  <!-- Que se anuncie con el nombre al que llega el cliente desde fuera del contenedor. -->
  <property><name>hbase.master.hostname</name><value>127.0.0.1</value></property>
  <property><name>hbase.regionserver.hostname</name><value>127.0.0.1</value></property>
  <property><name>hbase.zookeeper.quorum</name><value>127.0.0.1</value></property>
  <!-- Anunciarse como 127.0.0.1 hace que HBase se enlace tambien a 127.0.0.1: Docker acepta la conexion
       del puerto publicado y la corta. Se anuncia 127.0.0.1 pero se escucha en todas. -->
  <property><name>hbase.master.ipc.address</name><value>0.0.0.0</value></property>
  <property><name>hbase.regionserver.ipc.address</name><value>0.0.0.0</value></property>
  <property><name>hbase.zookeeper.property.clientPortAddress</name><value>0.0.0.0</value></property>
  <!-- Docker Desktop congela la VM al dormir el equipo: con los 90 s por defecto la sesion de ZooKeeper
       caduca y HBase se aborta. Diez minutos, tambien en el servidor. -->
  <property><name>zookeeper.session.timeout</name><value>600000</value></property>
  <property><name>hbase.zookeeper.property.maxSessionTimeout</name><value>600000</value></property>
  <!-- El arriendo de un scanner caduca a los 10 s y no a los 60 s: las pruebas de N2 (ficha 0072) lo dejan caducar. -->
  <property><name>hbase.client.scanner.timeout.period</name><value>10000</value></property>
</configuration>
