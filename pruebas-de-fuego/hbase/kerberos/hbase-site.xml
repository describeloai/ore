<?xml version="1.0"?>
<configuration>
  <property><name>hbase.cluster.distributed</name><value>false</value></property>
  <property><name>hbase.rootdir</name><value>file:///data/hbase</value></property>
  <property><name>hbase.zookeeper.property.dataDir</name><value>/data/zk</value></property>
  <property><name>hbase.unsafe.stream.capability.enforce</name><value>false</value></property>
  <property><name>hbase.master.hostname</name><value>hb.ore.test</value></property>
  <property><name>hbase.regionserver.hostname</name><value>hb.ore.test</value></property>
  <property><name>hbase.zookeeper.quorum</name><value>hb.ore.test</value></property>
  <property><name>hbase.master.ipc.address</name><value>0.0.0.0</value></property>
  <property><name>hbase.regionserver.ipc.address</name><value>0.0.0.0</value></property>
  <property><name>hbase.zookeeper.property.clientPortAddress</name><value>0.0.0.0</value></property>
  <property><name>zookeeper.session.timeout</name><value>600000</value></property>
  <property><name>hbase.zookeeper.property.maxSessionTimeout</name><value>600000</value></property>
  <!-- Kerberos en el RPC de HBase (no en ZooKeeper: el embebido queda abierto). -->
  <property><name>hbase.security.authentication</name><value>kerberos</value></property>
  <property><name>hadoop.security.authentication</name><value>kerberos</value></property>
  <property><name>hbase.security.authorization</name><value>false</value></property>
  <property><name>hbase.master.kerberos.principal</name><value>hbase/_HOST@ORE.TEST</value></property>
  <property><name>hbase.regionserver.kerberos.principal</name><value>hbase/_HOST@ORE.TEST</value></property>
  <property><name>hbase.master.keytab.file</name><value>/keytabs/hbase.keytab</value></property>
  <property><name>hbase.regionserver.keytab.file</name><value>/keytabs/hbase.keytab</value></property>
  <property><name>hbase.rpc.protection</name><value>${PROTECCION}</value></property>
</configuration>
